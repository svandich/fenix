$ P V = n R T quad quad P overline(V) = R T $

#pagebreak()

$ n = w/M quad quad V = (w R T)/(M P) quad quad overline(V) = V/n = (R T)/P $

#pagebreak()

$ underbrace(P V = C, "Boyle: " T", " m " ctes.") quad quad underbrace(V = V_0 (1 + alpha_0 t), "Charles–Gay-Lussac: " P", " m " ctes.") $

#pagebreak()

$ alpha_0 = 1/V_0 lr((partial V)/(partial t))_P quad quad T = 1/alpha_0 + t = 273.15 + t quad quad V = V_0 alpha_0 T $

#pagebreak()

$ R = (P_0 overline(V)_0)/T_0 = (1 "atm" dot.op 22.414 "L·mol"^(-1))/(273.15 "K") = 8.314 " J·K"^(-1) "mol"^(-1) $

#pagebreak()

$ underbrace(P = (R T)/overline(V), "isoterma") quad quad underbrace(overline(V) = (R T)/P, "isóbara") quad quad underbrace(P = (R T)/overline(V), "isócora") $

#pagebreak()

$ p_i = n_i (R T)/V quad quad P = sum_i p_i = n_t (R T)/V $

#pagebreak()

$ x_i = n_i/n_t = p_i/P quad => quad p_i = x_i P quad quad sum_i x_i = 1 $

#pagebreak()

$ d P = -(M g)/(R T) P thin d z quad => quad P = P_0 e^(-(M g (h - h_0))/(R T)) $
