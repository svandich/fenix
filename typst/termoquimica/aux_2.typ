$ Z = (P overline(V))/(R T) quad => quad overline(V) = (Z R T)/P quad quad Delta V = n (overline(V)_f - overline(V)_i) $

#pagebreak()

$ pi = P/P_c quad quad tau = T/T_c quad quad Z = Z(tau, pi) quad ("diagrama generalizado") $

#pagebreak()

$ lr((partial P)/(partial overline(V)))_(T_c) = 0 quad quad lr((partial^2 P)/(partial overline(V)^2))_(T_c) = 0 $

#pagebreak()

$ a = (27 R^2 T_c^2)/(64 P_c) quad quad b = (R T_c)/(8 P_c) quad quad Z_c = (P_c overline(V)_c)/(R T_c) = 3/8 = 0.375 $

#pagebreak()

$ Z = 1 + 1/(R T) (b - a/(R T)) P + dots quad => quad T_B = a/(R b) $

#pagebreak()

$ underbrace(Z approx 1 + (b P)/(R T) > 1, "P alta: domina " b) quad quad underbrace(Z approx 1 - (a P)/(R T)^2 < 1, "P baja: domina " a) quad quad underbrace(Z -> 1, "T alta, P baja") $
